# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chti?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# App
APP_BASE_URL=http://localhost:3000

# Auth (simple admin key for admin routes)
ADMIN_API_KEY=replace-with-strong-random

# Optional LLM key (reserved for future classifier)
OPTIONAL_LLM_API_KEY=

# NextAuth (reserved for future use)
NEXTAUTH_SECRET=

# Worker
INGEST_INTERVAL_MINS=30

# External Data Sources (Optional)
CRUNCHBASE_API_KEY=
ANGELLIST_API_KEY=
