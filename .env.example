# =============================================================================
# AI Innovators Network Pilot – Environment (copy to .env and fill for real data)
# =============================================================================

# --- Required for app + worker ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chti?schema=public
REDIS_URL=redis://localhost:6379

# --- App ---
APP_BASE_URL=http://localhost:3000
ADMIN_API_KEY=replace-with-strong-random

# Gate (security layer): 7-digit access code. Set in production.
# GATE_ACCESS_CODE=6101924

# --- Worker schedule (minutes between enrichment runs) ---
# Use 1440 for daily ingestion of latest news from APIs/RSS; 30 = every 30 min for dev.
INGEST_INTERVAL_MINS=1440

# --- Optional: LLM / Auth (reserved) ---
OPTIONAL_LLM_API_KEY=
NEXTAUTH_SECRET=

# =============================================================================
# External APIs – set any of these to test against real data (pilot tonight)
# Get keys at the URLs below; free tiers are enough for pilot testing.
# =============================================================================

# Crunchbase – company/funding data
# Get key: https://data.crunchbase.com (Settings → API Keys)
CRUNCHBASE_API_KEY=

# AngelList – startups
# Get key: https://angel.co (Settings → Developer / API Access)
ANGELLIST_API_KEY=

# OpenCorporates – company registry (optional; works without key at lower limits)
# Get key: https://api.opencorporates.com (optional for higher limits)
OPENCORPORATES_API_KEY=

# Alpha Vantage – market/news sentiment (free: ~25 req/day)
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Marketaux – financial/healthcare news (free: 100 req/day)
# Get key: https://www.marketaux.com/
MARKETAUX_API_KEY=

# NewsAPI.org – headlines (free: 100 req/day, dev only)
# Get key: https://newsapi.org/
NEWSAPI_API_KEY=

# NewsData.io – news with sentiment (free: 200 req/day)
# Get key: https://newsdata.io/
NEWSDATA_API_KEY=
