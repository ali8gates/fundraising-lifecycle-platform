{
  "name": "chti-innovators-network",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": "18.x" },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @chti/web dev",
    "dev:all": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:migrate": "pnpm --filter @chti/db prisma migrate dev",
    "prisma:migrate:deploy": "pnpm --filter @chti/db prisma migrate deploy",
    "prisma:seed": "pnpm --filter @chti/db prisma db seed",
    "apply-updates": "pnpm --filter @chti/db exec prisma migrate deploy && pnpm --filter @chti/db exec prisma generate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

